# ==============================================================================
# The Jawed Habib Salon – Lalganj
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env for local development:
#    cp .env.example .env
# 2. Never commit actual production credentials or passwords to version control.
# 3. For production deployments (Vercel, AWS, Cloud Run, or VPS), configure
#    these environment variables securely through your hosting provider's dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 14+ / Neon Serverless via Prisma ORM)
# ------------------------------------------------------------------------------
# 2.1 Pooled Connection (Used for serverless route handling and queries)
# Format (Local): postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Format (Neon):  postgresql://<USER>:<PASSWORD>@<HOST>-pooler.ap-southeast-1.aws.neon.tech/<DATABASE>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jawed_habib_lalganj?schema=public"

# 2.2 Direct Unpooled Connection (Required by Prisma for migrations and schema updates)
# Format (Local): postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Format (Neon):  postgresql://<USER>:<PASSWORD>@<HOST>.ap-southeast-1.aws.neon.tech/<DATABASE>?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jawed_habib_lalganj?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/jawed_habib_lalganj?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random secret (e.g. `openssl rand -base64 32`)
JWT_SECRET="replace-with-a-secure-random-32-character-secret-in-production"
JWT_EXPIRES_IN="7d"

# Default Initial Administrator Credentials (Used by prisma/seed.ts)
ADMIN_DEFAULT_EMAIL="admin@jawedhabib-lalganj.in"
ADMIN_DEFAULT_PASSWORD="ReplaceWithStrongPassword2026!"

# ------------------------------------------------------------------------------
# 4. PAYMENT ENCRYPTION & DATA PROTECTION
# ------------------------------------------------------------------------------
# Master key used for AES-256-GCM encryption of database-stored gateway secrets
# Generate a 32+ character key: `openssl rand -hex 32`
PAYMENT_ENCRYPTION_KEY="replace-with-a-secure-payment-encryption-master-key-32-chars"

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Obtain Test Key ID & Secret from: https://dashboard.razorpay.com/app/keys
# Test keys start with "rzp_test_", Live keys start with "rzp_live_"
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Webhook Secret configured in Razorpay Dashboard > Settings > Webhooks
# Events to subscribe: payment.captured, payment.failed, order.paid, refund.processed
# Webhook URL: https://yourdomain.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 6. FILE STORAGE (Cloudinary CDN for Transformations & Gallery)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Console: https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_UPLOAD_PRESET="jawed_habib_lalganj"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL & CRON (Resend API & Vercel Scheduled Tasks)
# ------------------------------------------------------------------------------
# Obtain API Key from Resend Console: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="The Jawed Habib Salon – Lalganj <notifications@thejawedhabibsalons.in>"
EMAIL_REPLY_TO="support@thejawedhabibsalons.in"

# Secret used to authenticate Vercel Cron worker invocations (/api/cron/reminders)
# Generate a 32+ character random secret (e.g. `openssl rand -hex 32`)
CRON_SECRET="replace-with-a-secure-random-cron-secret-32-chars"

# Optional Legacy SMTP Fallback Relay
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@jawedhabib-lalganj.in"
SMTP_PASSWORD="your_smtp_app_password"

# ------------------------------------------------------------------------------
# 8. SALON GROUND TRUTH (Public Client Constants)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SALON_NAME="The Jawed Habib Salon – Lalganj"
NEXT_PUBLIC_SALON_PHONE_PRIMARY="7707000463"
NEXT_PUBLIC_SALON_PHONE_SECONDARY="9831722983"
NEXT_PUBLIC_SALON_PHONE_TERTIARY="9580000175"
NEXT_PUBLIC_SALON_WHATSAPP="917707000463"
NEXT_PUBLIC_SALON_INSTAGRAM="https://www.instagram.com/the_jawedhabib_lalganj/"
NEXT_PUBLIC_SALON_MAPS_URL="https://maps.app.goo.gl/TVx48xoWEu8dMvXT9"

# ------------------------------------------------------------------------------
# 9. CONTACT ENQUIRY & GOOGLE SHEETS SYNCHRONIZATION
# ------------------------------------------------------------------------------
# Destination administrator email for customer website enquiry notifications
CONTACT_NOTIFICATION_EMAIL="contact@thejawedhabibsalons.in"

# Enable / Disable automatic appending of enquiries to Google Spreadsheet
GOOGLE_SHEETS_ENABLED="false"

# Google Sheet ID extracted from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Google Cloud IAM Service Account Email with Editor access to the spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL="salon-enquiries-sync@your-project-id.iam.gserviceaccount.com"

# Google Cloud Service Account Private Key (PEM format including -----BEGIN/END PRIVATE KEY-----)
# Note: Escape newlines with \n when storing in single-line environment configs
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
